<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="sort-only" default-locale="en-US">
  <info>
    <title>IEEE (Wrexham University Guide, September 2023)</title>
    <title-short>IEEE Wrexham</title-short>
    <id>http://www.zotero.org/styles/ieee-wrexham</id>
    <link href="http://www.zotero.org/styles/ieee-wrexham" rel="self"/>
    <link href="http://www.zotero.org/styles/ieee" rel="template"/>
    <author>
      <name>Stefan Brenner</name>
    </author>
    <category citation-format="numeric"/>
    <category field="engineering"/>
    <category field="generic-base"/>
    <summary>IEEE-Zitierstil nach der Wrexham University Anleitung "IEEE Referencing, The Wrexham University Guide" (September 2023). Abweichungen vom Standard-IEEE: Mehrfachzitate in einer Klammer [2, 7, 12]; Seitenangabe im Text ohne Leerzeichen [8, p.156]; kein Oxford-Komma vor "and"; Webseiten mit "Author. "Title." Website. Accessed: Datum. [Online] Available: URL."; Zeitschriften ohne DOI mit "[Online]. Available: URL." ohne Zugriffsdatum; eigene Formate für Handbuecher, Software, Bilder, Rundfunk, DVD, Online-Video, Tonaufnahme und Social-Media-Posts; Bilder/Diagramme aus einem Buch koennen direkt als "graphic"-Typ mit gesetztem container-title erfasst werden.</summary>
    <updated>2026-09-06T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale xml:lang="en">
    <date form="text">
      <date-part name="month" form="short" suffix=" "/>
      <date-part name="day" form="numeric" suffix=", "/>
      <date-part name="year"/>
    </date>
    <terms>
      <term name="chapter" form="short">ch.</term>
      <term name="chapter-number" form="short">ch.</term>
      <!-- Wrexham: "presented at" ohne "the" -->
      <term name="presented at">presented at</term>
      <term name="available at">available</term>
      <!-- Wrexham: Rolle bei Tonaufnahmen, z. B. "B. Scott, Composer" -->
      <term name="composer">
        <single>composer</single>
        <multiple>composers</multiple>
      </term>
      <!-- immer Drei-Buchstaben-Monate -->
      <term name="month-06" form="short">Jun.</term>
      <term name="month-07" form="short">Jul.</term>
      <term name="month-09" form="short">Sep.</term>
    </terms>
  </locale>

  <!-- ===================== Makros ===================== -->

  <macro name="status">
    <choose>
      <if variable="page issue volume" match="none">
        <text variable="status" text-case="capitalize-first" font-weight="bold"/>
      </if>
    </choose>
  </macro>

  <macro name="edition">
    <choose>
      <if type="bill book chapter graphic legal_case legislation motion_picture paper-conference report song" match="any">
        <choose>
          <if is-numeric="edition">
            <group delimiter=" ">
              <number variable="edition" form="ordinal"/>
              <text term="edition" form="short"/>
            </group>
          </if>
          <else>
            <text variable="edition" text-case="capitalize-first" suffix="."/>
          </else>
        </choose>
      </if>
    </choose>
  </macro>

  <!-- Datumsvarianten -->
  <macro name="issued-year">
    <date variable="issued">
      <date-part name="year" form="long"/>
    </date>
  </macro>
  <macro name="issued-month-year">
    <date variable="issued">
      <date-part name="month" form="short" suffix=" "/>
      <date-part name="year" form="long"/>
    </date>
  </macro>
  <macro name="issued-full">
    <date variable="issued" form="text"/>
  </macro>

  <!--
    Wrexham: Autoren bis 6 alle nennen, ab 7 nur der erste + "et al." (kursiv).
    Kein Oxford-Komma: "A. Autor, B. Autor and C. Autor".
  -->
  <macro name="author">
    <choose>
      <if type="song">
        <!-- Tonaufnahme: "B. Scott, Composer, Titel" -->
        <names variable="composer">
          <name and="text" delimiter-precedes-last="never" et-al-min="7" et-al-use-first="1" initialize-with=". "/>
          <label form="long" prefix=", " text-case="capitalize-first"/>
          <et-al font-style="italic"/>
          <substitute>
            <names variable="author"/>
          </substitute>
        </names>
      </if>
      <else>
        <names variable="author">
          <name and="text" delimiter-precedes-last="never" et-al-min="7" et-al-use-first="1" initialize-with=". "/>
          <label form="short" prefix=", " text-case="capitalize-first"/>
          <et-al font-style="italic"/>
          <substitute>
            <names variable="editor"/>
            <text macro="director"/>
            <names variable="composer"/>
            <names variable="translator"/>
          </substitute>
        </names>
      </else>
    </choose>
  </macro>

  <!--
    Satzzeichen nach dem Autor: Wrexham setzt bei Webseiten, Software, Online-Handbuechern,
    Social-Media-Posts und Online-Konferenzbeitraegen einen Punkt, sonst ein Komma.
  -->
  <macro name="author-punct">
    <choose>
      <if type="webpage post post-weblog software" match="any">
        <text value="."/>
      </if>
      <else-if type="report" variable="URL" match="all">
        <text value="."/>
      </else-if>
      <else-if type="paper-conference speech" match="any">
        <choose>
          <if variable="container-title">
            <text value=","/>
          </if>
          <else-if variable="URL">
            <text value="."/>
          </else-if>
          <else>
            <text value=","/>
          </else>
        </choose>
      </else-if>
      <else>
        <text value=","/>
      </else>
    </choose>
  </macro>

  <macro name="editor">
    <names variable="editor">
      <name initialize-with=". " delimiter=", " and="text" delimiter-precedes-last="never"/>
      <label form="short" prefix=", " text-case="capitalize-first"/>
    </names>
  </macro>

  <macro name="director">
    <names variable="director">
      <name and="text" delimiter-precedes-last="never" et-al-min="7" et-al-use-first="1" initialize-with=". "/>
      <et-al font-style="italic"/>
    </names>
  </macro>

  <macro name="locators">
    <group delimiter=", ">
      <text macro="edition"/>
      <group delimiter=" ">
        <text term="volume" form="short"/>
        <number variable="volume" form="numeric"/>
      </group>
      <group delimiter=" ">
        <number variable="number-of-volumes" form="numeric"/>
        <text term="volume" form="short" plural="true"/>
      </group>
      <group delimiter=" ">
        <text term="issue" form="short"/>
        <number variable="issue" form="numeric"/>
      </group>
    </group>
  </macro>

  <macro name="title">
    <choose>
      <if type="bill book graphic legal_case legislation motion_picture song standard software report" match="any">
        <text variable="title" font-style="italic"/>
      </if>
      <else>
        <text variable="title" quotes="true"/>
      </else>
    </choose>
  </macro>

  <!-- Medium in eckigen Klammern, mit typabhaengigem Standardwert -->
  <macro name="medium">
    <group prefix="[" suffix="]">
      <choose>
        <if variable="medium">
          <text variable="medium" text-case="capitalize-first"/>
        </if>
        <else-if type="motion_picture">
          <choose>
            <if variable="URL">
              <text value="Online Video"/>
            </if>
            <else>
              <text value="Film"/>
            </else>
          </choose>
        </else-if>
        <else-if type="song">
          <text value="Sound Recording"/>
        </else-if>
        <else-if type="broadcast">
          <text value="Broadcast"/>
        </else-if>
        <else-if type="graphic">
          <choose>
            <if variable="URL">
              <text value="Online image"/>
            </if>
            <else>
              <text value="Image"/>
            </else>
          </choose>
        </else-if>
        <else-if type="post">
          <choose>
            <if variable="genre">
              <text variable="genre" text-case="capitalize-first"/>
            </if>
            <else>
              <text value="Post"/>
            </else>
          </choose>
        </else-if>
        <else>
          <text value="Online"/>
        </else>
      </choose>
    </group>
  </macro>

  <macro name="publisher">
    <choose>
      <if type="bill book chapter graphic legal_case legislation motion_picture paper-conference song broadcast" match="any">
        <group delimiter=": ">
          <text variable="publisher-place"/>
          <text variable="publisher"/>
        </group>
      </if>
      <else>
        <group delimiter=", ">
          <text variable="publisher"/>
          <text variable="publisher-place"/>
        </group>
      </else>
    </choose>
  </macro>

  <!-- Accessed: Mon. D, YYYY. -->
  <macro name="accessed">
    <group delimiter=": " suffix=".">
      <text term="accessed" text-case="capitalize-first"/>
      <date variable="accessed" form="text"/>
    </group>
  </macro>

  <!-- Available: URL. -->
  <macro name="available">
    <group delimiter=": " suffix=".">
      <text value="Available"/>
      <text variable="URL"/>
    </group>
  </macro>

  <!-- Guide S. 11 und S. 14: Handbuch, Software, Online-Video enden ohne Punkt nach der URL -->
  <macro name="available-nodot">
    <group delimiter=": ">
      <text value="Available"/>
      <text variable="URL"/>
    </group>
  </macro>

  <!-- Buecher, Kapitel, Zeitschriften, Konferenzen: " [Online]. Available: URL." -->
  <macro name="online-available">
    <choose>
      <if variable="URL">
        <group delimiter=" " prefix=" ">
          <text value="[Online]."/>
          <text macro="available"/>
        </group>
      </if>
    </choose>
  </macro>

  <!-- Software, Online-Handbuch, Online-Video: " Accessed: Datum. [Medium]. Available: URL" (ohne Schlusspunkt, Guide S. 11, 14) -->
  <macro name="access-accessed">
    <choose>
      <if variable="URL">
        <group delimiter=" " prefix=" ">
          <text macro="accessed"/>
          <text macro="medium" suffix="."/>
          <text macro="available-nodot"/>
        </group>
      </if>
    </choose>
  </macro>

  <!-- Buecher u. ae.: DOI oder [Online]. Available -->
  <macro name="doi-or-online">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix=" doi: " suffix="."/>
      </if>
      <else>
        <text macro="online-available"/>
      </else>
    </choose>
  </macro>

  <macro name="page">
    <choose>
      <if type="article-journal" variable="number" match="all">
        <group delimiter=" ">
          <text value="Art."/>
          <text term="issue" form="short"/>
          <text variable="number"/>
        </group>
      </if>
      <else>
        <group delimiter=" ">
          <label variable="page" form="short"/>
          <text variable="page"/>
        </group>
      </else>
    </choose>
  </macro>

  <!--
    Wrexham: Seitenangabe im Text OHNE Leerzeichen, z. B. [8, p.156].
    Im Literaturverzeichnis bleibt "pp. 32-40" mit Leerzeichen.
  -->
  <macro name="citation-locator">
    <choose>
      <if locator="page">
        <group delimiter="">
          <label variable="locator" form="short"/>
          <text variable="locator"/>
        </group>
      </if>
      <else>
        <group delimiter=" ">
          <label variable="locator" form="short" text-case="capitalize-first"/>
          <text variable="locator"/>
        </group>
      </else>
    </choose>
  </macro>

  <macro name="geographic-location">
    <group delimiter=", " suffix=".">
      <choose>
        <if variable="publisher-place">
          <text variable="publisher-place" text-case="title"/>
        </if>
        <else-if variable="event-place">
          <text variable="event-place" text-case="title"/>
        </else-if>
      </choose>
    </group>
  </macro>

  <!-- Reihe -->
  <macro name="collection">
    <choose>
      <if variable="collection-title" match="any">
        <text term="in" suffix=" "/>
        <group delimiter=", " suffix=". ">
          <text variable="collection-title"/>
          <text variable="collection-number" prefix="no. "/>
          <text variable="volume" prefix="vol. "/>
        </group>
      </if>
    </choose>
  </macro>

  <!-- ===================== Zitat im Text ===================== -->
  <!-- Wrexham: mehrere Quellen in EINER Klammer, durch Komma getrennt: [2, 7, 12] -->
  <citation>
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <group delimiter=", ">
        <text variable="citation-number"/>
        <text macro="citation-locator"/>
      </group>
    </layout>
  </citation>

  <!-- ===================== Literaturverzeichnis ===================== -->
  <bibliography entry-spacing="0" hanging-indent="false">
    <layout>
      <text variable="citation-number" prefix="[" suffix="] "/>
      <!-- Autor(en) + typabhaengiges Satzzeichen -->
      <choose>
        <if type="software">
          <!-- Guide S. 11: Software beginnt mit dem Titel, kein Autor -->
          <text value=""/>
        </if>
        <else-if variable="author editor translator director composer" match="any">
          <group suffix=" ">
            <text macro="author"/>
            <text macro="author-punct"/>
          </group>
        </else-if>
      </choose>
      <choose>

        <!-- Zeitschriftenartikel -->
        <if type="article-journal">
          <group delimiter=", ">
            <text macro="title"/>
            <text variable="container-title" font-style="italic" form="short"/>
            <text macro="locators"/>
            <text macro="page"/>
            <text macro="issued-month-year"/>
            <text macro="status"/>
          </group>
          <choose>
            <if variable="DOI">
              <text variable="DOI" prefix=", doi: " suffix="."/>
            </if>
            <else-if variable="URL">
              <text value="."/>
              <text macro="online-available"/>
            </else-if>
            <else>
              <text value="."/>
            </else>
          </choose>
        </if>

        <!-- Konferenzbeitraege -->
        <else-if type="paper-conference speech" match="any">
          <choose>
            <!-- veroeffentlicht (in Proceedings) -->
            <if variable="container-title">
              <group delimiter=", ">
                <text macro="title"/>
                <group delimiter=" ">
                  <text term="in"/>
                  <text variable="container-title" font-style="italic"/>
                </group>
                <text variable="event-place"/>
                <text macro="issued-full"/>
                <text macro="editor"/>
              </group>
              <choose>
                <if variable="publisher">
                  <choose>
                    <if variable="editor" match="none">
                      <text value="."/>
                    </if>
                  </choose>
                  <group delimiter=", " prefix=" " suffix=".">
                    <text macro="publisher"/>
                    <text macro="issued-year"/>
                    <text macro="page"/>
                  </group>
                </if>
                <else-if variable="page">
                  <text macro="page" prefix=", " suffix="."/>
                </else-if>
                <else>
                  <text value="."/>
                </else>
              </choose>
              <text macro="online-available"/>
            </if>
            <!-- nur online: Author. (Date). Title. Presented at Conf, Location. [Online]. Available: URL. -->
            <else-if variable="URL">
              <group delimiter=" ">
                <text macro="issued-full" prefix="(" suffix=")."/>
                <text variable="title" suffix="."/>
                <group delimiter=", " suffix=".">
                  <group delimiter=" ">
                    <text term="presented at" text-case="capitalize-first"/>
                    <text variable="event"/>
                  </group>
                  <text variable="event-place"/>
                </group>
              </group>
              <text macro="online-available"/>
            </else-if>
            <!-- unveroeffentlicht: "Title," presented at Conf, Location, Date, Paper N. -->
            <else>
              <group delimiter=", " suffix=".">
                <text macro="title"/>
                <group delimiter=" ">
                  <text term="presented at"/>
                  <text variable="event"/>
                </group>
                <text variable="event-place"/>
                <text macro="issued-full"/>
                <text variable="number" prefix="Paper "/>
              </group>
            </else>
          </choose>
        </else-if>

        <!-- Buchkapitel (und Bild aus einem Buch, wenn "medium" gesetzt ist) -->
        <else-if type="chapter">
          <choose>
            <if variable="medium">
              <!-- "Title", [Diagram] in Buchtitel, 5th ed. Place: Publisher, Year, p. 120. -->
              <!-- Guide S. 12: "Title", [Diagram] in Source. 5th ed. Place: Publisher, Year, p.120. -->
              <group delimiter=" " suffix=" ">
                <text variable="title" prefix="“" suffix="”,"/>
                <text macro="medium"/>
                <text term="in"/>
                <text variable="container-title" font-style="italic" suffix="."/>
                <text macro="edition"/>
              </group>
              <group delimiter=", " suffix=".">
                <text macro="publisher"/>
                <text macro="issued-year"/>
                <group>
                  <label variable="page" form="short"/>
                  <text variable="page"/>
                </group>
              </group>
              <text macro="doi-or-online"/>
            </if>
            <else>
              <group delimiter=", " suffix=".">
                <text macro="title"/>
                <group delimiter=" ">
                  <text term="in"/>
                  <text variable="container-title" font-style="italic"/>
                </group>
                <text macro="locators"/>
                <text macro="editor"/>
                <text macro="collection"/>
                <text macro="publisher"/>
                <text macro="issued-year"/>
                <group delimiter=" ">
                  <label variable="chapter-number" form="short"/>
                  <text variable="chapter-number"/>
                </group>
                <text macro="page"/>
              </group>
              <text macro="doi-or-online"/>
            </else>
          </choose>
        </else-if>

        <!-- Handbuch / Bericht -->
        <else-if type="report">
          <choose>
            <!-- online: Author. Title. (Year). Accessed: Datum. [Online] Available: URL. -->
            <if variable="URL">
              <group delimiter=" ">
                <group delimiter=", " suffix=".">
                  <text macro="title"/>
                  <text macro="edition"/>
                </group>
                <text macro="issued-year" prefix="(" suffix=")."/>
              </group>
              <text macro="access-accessed"/>
            </if>
            <!-- gedruckt: Title, 3rd ed., Company, City, Country, Year, pp. xx-xx. -->
            <else>
              <group delimiter=", " suffix=".">
                <text macro="title"/>
                <text macro="edition"/>
                <text variable="publisher"/>
                <text variable="publisher-place"/>
                <group delimiter=" ">
                  <text variable="genre"/>
                  <text variable="number"/>
                </group>
                <text macro="issued-month-year"/>
                <text macro="page"/>
              </group>
            </else>
          </choose>
        </else-if>

        <!-- Abschlussarbeit -->
        <else-if type="thesis">
          <group delimiter=", " suffix=".">
            <text macro="title"/>
            <text variable="genre"/>
            <text macro="publisher"/>
            <text macro="issued-year"/>
          </group>
          <text macro="doi-or-online"/>
        </else-if>

        <!-- Software: Title. (Version, Year). Publisher. Accessed: Datum. [Online] Available: URL. -->
        <else-if type="software">
          <group delimiter=". " suffix=".">
            <text macro="title"/>
            <!-- Guide S. 11: "(version or year)", also Version, sonst Jahr -->
            <choose>
              <if variable="version">
                <text variable="version" prefix="(" suffix=")"/>
              </if>
              <else>
                <text macro="issued-year" prefix="(" suffix=")"/>
              </else>
            </choose>
            <text variable="genre"/>
            <text variable="publisher"/>
          </group>
          <text macro="access-accessed"/>
        </else-if>

        <!-- Webseite: Author. "Title." (Date). Website. Accessed: Datum. [Online] Available: URL. -->
        <else-if type="webpage post-weblog" match="any">
          <group delimiter=" ">
            <text variable="title" quotes="true" suffix="."/>
            <text macro="issued-full" prefix="(" suffix=")."/>
            <text variable="container-title" suffix="."/>
            <choose>
              <if variable="URL">
                <text macro="accessed"/>
                <text value="[Online]"/>
                <text macro="available"/>
              </if>
            </choose>
          </group>
        </else-if>

        <!-- Social-Media-Post: @handle. Text. 20 Apr. 2012. [Tweet]. Available: URL [Accessed: Datum]. -->
        <else-if type="post">
          <group delimiter=" ">
            <text variable="title" suffix="."/>
            <date variable="issued" suffix=".">
              <date-part name="day" form="numeric" suffix=" "/>
              <date-part name="month" form="short" strip-periods="true" suffix=" "/>
              <date-part name="year"/>
            </date>
            <text macro="medium" suffix="."/>
            <choose>
              <if variable="URL">
                <group delimiter=" " suffix=".">
                  <group delimiter=": ">
                    <text value="Available"/>
                    <text variable="URL"/>
                  </group>
                  <group prefix="[" suffix="]" delimiter=": ">
                    <text term="accessed" text-case="capitalize-first"/>
                    <date variable="accessed">
                      <date-part name="day" form="numeric" suffix=" "/>
                      <date-part name="month" form="short" strip-periods="true" suffix=" "/>
                      <date-part name="year"/>
                    </date>
                  </group>
                </group>
              </if>
            </choose>
          </group>
        </else-if>

        <!-- Patent -->
        <else-if type="patent">
          <group delimiter=", " suffix=".">
            <text macro="title"/>
            <text variable="number"/>
            <text macro="issued-full"/>
          </group>
          <text macro="doi-or-online"/>
        </else-if>

        <!-- Film / DVD / Online-Video -->
        <else-if type="motion_picture">
          <choose>
            <!-- YouTube u. ae.: Creator, Title. (Date). Accessed: Datum. [Online Video]. Available: URL. -->
            <if variable="URL">
              <group delimiter=" ">
                <text macro="title" suffix="."/>
                <text macro="issued-full" prefix="(" suffix=")."/>
              </group>
              <text macro="access-accessed"/>
            </if>
            <!-- DVD: Producer, Title. [DVD]. Place: Company, Year. -->
            <else>
              <group delimiter=" ">
                <text macro="title" suffix="."/>
                <text macro="medium" suffix="."/>
                <group delimiter=", " suffix=".">
                  <text macro="publisher"/>
                  <text macro="issued-year"/>
                </group>
              </group>
            </else>
          </choose>
        </else-if>

        <!-- Radio / Fernsehen: Presenter, "Episode," Programme, Mon. D, YYYY [Television broadcast]. Place: Company. -->
        <else-if type="broadcast">
          <group delimiter=", ">
            <choose>
              <if variable="container-title">
                <text variable="title" quotes="true"/>
              </if>
              <else>
                <text variable="title" font-style="italic"/>
              </else>
            </choose>
            <text variable="container-title" font-style="italic"/>
            <group delimiter=" ">
              <text macro="issued-full"/>
              <text macro="medium"/>
            </group>
          </group>
          <text value="."/>
          <group prefix=" " suffix=".">
            <text macro="publisher"/>
          </group>
          <text macro="online-available"/>
        </else-if>

        <!-- Tonaufnahme: Composer, Title [Sound Recording]. Place: Company, Year. -->
        <else-if type="song">
          <group delimiter=" ">
            <text macro="title"/>
            <text macro="medium"/>
          </group>
          <text value="."/>
          <group delimiter=", " prefix=" " suffix=".">
            <text macro="publisher"/>
            <text macro="issued-year"/>
          </group>
          <text macro="online-available"/>
        </else-if>

        <!-- Bild / Kunstwerk -->
        <else-if type="graphic">
          <choose>
            <!-- Bild/Diagramm aus einem Buch o.ae. (container-title gesetzt):
                 "Title", [Diagram] in Source. Ed. Place: Publisher, Year, p.xx.
                 Guide S. 12, Ulrich/Eppinger-Beispiel. Alternative zum
                 chapter+medium-Workaround unten, direkt ueber den graphic-Typ nutzbar. -->
            <if variable="container-title">
              <group delimiter=" " suffix=" ">
                <text variable="title" prefix="“" suffix="”,"/>
                <text macro="medium"/>
                <text term="in"/>
                <text variable="container-title" font-style="italic" suffix="."/>
                <text macro="edition"/>
              </group>
              <group delimiter=", " suffix=".">
                <text macro="publisher"/>
                <text macro="issued-year"/>
                <text macro="page"/>
              </group>
              <text macro="doi-or-online"/>
            </if>
            <!-- Eigenstaendiges Bild, i. d. R. von einer Website -->
            <else>
              <!-- Guide S. 12: Titel ohne Anführungszeichen, Medium direkt dahinter -->
              <group delimiter=", " suffix=".">
                <group delimiter=" ">
                  <text variable="title"/>
                  <text macro="medium"/>
                </group>
                <text macro="publisher"/>
                <text macro="issued-year"/>
              </group>
              <choose>
                <if variable="URL">
                  <group delimiter=" " prefix=" " suffix=".">
                    <text value="Available from"/>
                    <text variable="URL"/>
                    <group prefix="[" suffix="]" delimiter=" ">
                      <text term="accessed" text-case="capitalize-first"/>
                      <date variable="accessed" form="text"/>
                    </group>
                  </group>
                </if>
              </choose>
            </else>
          </choose>
        </else-if>

        <!-- Norm -->
        <else-if type="standard">
          <group delimiter=", " suffix=".">
            <text macro="title"/>
            <group delimiter=" ">
              <text variable="genre"/>
              <text variable="number"/>
            </group>
            <text variable="publisher"/>
            <text variable="publisher-place"/>
            <text macro="issued-year"/>
          </group>
          <text macro="doi-or-online"/>
        </else-if>

        <!-- Buch und Aehnliches -->
        <else-if type="bill book legal_case legislation" match="any">
          <group delimiter=", " suffix=". ">
            <text macro="title"/>
            <text macro="locators"/>
          </group>
          <text macro="collection"/>
          <group delimiter=", " suffix=".">
            <text macro="publisher"/>
            <text macro="issued-year"/>
            <text macro="page"/>
          </group>
          <text macro="doi-or-online"/>
        </else-if>

        <!-- Zeitschriften/Zeitungen ohne Peer-Review, Interviews, Manuskripte, Karten usw. -->
        <else-if type="article-magazine article-newspaper interview manuscript map personal_communication" match="any">
          <group delimiter=", " suffix=".">
            <text macro="title"/>
            <text variable="container-title" font-style="italic"/>
            <text macro="locators"/>
            <text macro="publisher"/>
            <text macro="page"/>
            <text macro="issued-full"/>
          </group>
          <text macro="doi-or-online"/>
        </else-if>

        <!-- Rueckfall -->
        <else>
          <group delimiter=", " suffix=". ">
            <text macro="title"/>
            <text variable="container-title" font-style="italic"/>
            <text macro="locators"/>
          </group>
          <text macro="collection"/>
          <group delimiter=", " suffix=".">
            <text macro="publisher"/>
            <text macro="page"/>
            <text macro="issued-full"/>
          </group>
          <text macro="doi-or-online"/>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
